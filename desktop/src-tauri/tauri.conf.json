{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilingLens",
  "version": "0.2.0",
  "identifier": "com.filinglens.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [{
      "title": "FilingLens",
      "width": 1450,
      "height": 940,
      "minWidth": 850,
      "minHeight": 650,
      "backgroundColor": "#f5f4ef"
    }],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/filinglens-api"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"]
  }
}
