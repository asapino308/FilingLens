# SEC asks automated clients to identify themselves. Replace with your contact email.
SEC_USER_AGENT=FilingLens/1.0 your-email@example.com
# auto checks LM Studio, local Ollama, Ollama Cloud, OpenAI, and Anthropic.
# Use lmstudio, ollama, ollama_cloud, openai, or anthropic to force one provider.
AI_PROVIDER=auto
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Leave blank to discover and select the first model exposed by LM Studio.
LMSTUDIO_MODEL=
# LM Studio normally needs no key; leave blank unless authentication is enabled.
LMSTUDIO_API_KEY=
# Local generation can take several minutes on larger models. Increase if needed.
LMSTUDIO_TIMEOUT_SECONDS=300
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Leave blank to discover installed Ollama models.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=300

# Ollama Cloud direct API. Create a key at https://ollama.com/settings/keys.
# Filing text, verified metrics, and questions are sent to Ollama when this provider is selected.
OLLAMA_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com
# Leave blank to discover cloud models from https://ollama.com/api/tags.
OLLAMA_CLOUD_MODEL=
OLLAMA_CLOUD_TIMEOUT_SECONDS=300

# Optional direct cloud APIs. Leave model blank to discover models using the saved key.
# The selected provider receives questions, verified metrics, and retrieved filing passages.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
